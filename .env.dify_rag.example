# 基于 Dify 的实验室安全小助手运行模板
# 复制为 .env.dify_rag 后填写真实 Dify 应用 Key。

DIFY_BASE_URL=http://127.0.0.1:8080
DIFY_APP_API_KEY=
DIFY_TIMEOUT=120

DEMO_PORT=8088
DEFAULT_TOP_K=4
LOW_CONFIDENCE_TOP_SCORE=3.5
KB_IMPORT_SUCCESS_COUNT=398
KB_CHUNK_IMPORT_COUNT=3164
KB_EXTERNAL_IMPORT_COUNT=1159

# 默认关闭本地 embedding，保持第一个项目轻量；如需语义检索可设为 1 并安装 sentence-transformers。
ENABLE_EMBEDDING=0
SEMANTIC_WEIGHT=12.0
