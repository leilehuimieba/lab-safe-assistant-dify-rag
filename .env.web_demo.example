# Copy to .env.web_demo and replace this value with a strong local-only password.
# Never commit the real file.
DEMO_PASSWORD=replace-with-a-strong-local-password
# The default returns a complete cited local-KB answer without waiting for
# Dify's full token stream.  Set to dify only when a generative answer is
# explicitly preferred over the complete-response latency target.
LABSAFE_RESPONSE_MODE=local_complete
